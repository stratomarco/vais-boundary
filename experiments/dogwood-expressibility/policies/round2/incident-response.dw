forbid (principal, action == Inc::Action::"status.build_public_update", resource)
when { context.input has incident_id }
when temporal { !formerly within 24h Inc::Action::"TaskBind"::response{ input.tool: "status.build_public_update", input.arg: "incident_id", input.value: context.input.incident_id } && !formerly within 24h Inc::Action::"TaskAllow"::response{ input.tool: "status.build_public_update", input.arg: "incident_id", input.value: context.input.incident_id, input.once: _ } };
