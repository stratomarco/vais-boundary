---
import Page from './Page.astro';
const { frontmatter } = Astro.props;
const root = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---
<Page title={`${frontmatter.title} — VAIS Boundary`} description={frontmatter.description}>
  <article class="wrap page-content prose"><a href={`${root}articles/`}>← All articles</a><p class="eyebrow">{frontmatter.date}</p><h1>{frontmatter.title}</h1><p class="intro">{frontmatter.description}</p><slot /></article>
</Page>
