---
import '../styles/global.css';
const { title = 'VAIS Boundary — Authority outside the model', description = 'A deterministic security boundary between AI agents and consequential tools. Enforce authority. Verify observable effects.' } = Astro.props;
const root = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${root}favicon.svg`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="header wrap">
      <a class="wordmark" href={root} aria-label="VAIS Boundary home"><strong>VAIS<span class="brand-rule" aria-hidden="true"></span></strong><span>BOUNDARY</span></a>
      <nav aria-label="Main navigation">
        <a href={`${root}articles/`}>Articles</a>
        <a href={`${root}#contact`}>Contact</a>
        <a href="https://github.com/stratomarco/vais-boundary">GitHub <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="footer wrap"><span>VAIS Boundary</span><span>Verifiable Authority &amp; Invariant Security</span><a href={`${root}privacy/`}>Privacy</a></footer>
  </body>
</html>
