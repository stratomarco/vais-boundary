---
import '../styles/global.css';
const { title = 'VAIS Boundary — Authority outside the model', description = 'A deterministic security boundary between AI agents and consequential tools. Enforce authority. Verify observable effects.', canonicalUrl } = Astro.props;
const root = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
// Pieces first published elsewhere point their canonical at the original, so search
// engines do not treat the copy here as a duplicate of it.
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <link rel="alternate" type="application/rss+xml" title="VAIS Boundary articles" href={`${root}rss.xml`} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${root}favicon.ico`} sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href={`${root}brand/vais-mark-16-light.svg`} sizes="16x16" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(`${root}brand/vais-social-preview-1280x640.png`, Astro.site)} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="VAIS Boundary — Verifiable Authority & Invariant Security" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="header wrap">
      <a class="wordmark" href={root} aria-label="VAIS Boundary home"><img src={`${root}brand/vais-logo-horizontal-light.svg`} width="186" height="61" alt="VAIS Boundary" /></a>
      <nav aria-label="Main navigation">
        <a href={`${root}#evidence`}>Evidence</a>
        <a href={`${root}articles/`}>Articles</a>
        <a href={`${root}#contact`}>Contact</a>
        <a href="https://github.com/stratomarco/vais-boundary">GitHub <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="footer wrap"><span>VAIS Boundary</span><span>Verifiable Authority &amp; Invariant Security</span><a href={`${root}privacy/`}>Privacy</a></footer>
  </body>
</html>
